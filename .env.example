# Copy to .env and fill in the credentials sent to your registered email.
API_KEY=YOUR_PUBLIC_KEY
SECRET_KEY=YOUR_SECRET_KEY

# Optional overrides (defaults shown)
# FEED_URL=wss://v3-prod.livefxhub.com/ws/algo
# PRICE_BASIS=mid            # mid | bid | ask: price the 24h stats are computed on
# WINDOW=24h
# BUCKET=1m
# SPIKE_THRESHOLD_PCT=10
# SPIKE_CONFIRM_TICKS=3
# MAX_FRAME_BYTES=8192
# LOG_LEVEL=info
